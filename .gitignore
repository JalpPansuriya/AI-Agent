# Environment variables
.env

# Python caching & bytecode
__pycache__/
*.pyc

# Cache directories
.pytest_cache/
.ruff_cache/

# Database migrations (keep __init__.py, ignore autogenerated revisions if requested, but let's write exact rule)
migrations/versions/*.py
!migrations/versions/__init__.py

# Frontend builds and dependencies
dist/
node_modules/
