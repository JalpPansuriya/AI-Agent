# App Configuration
APP_ENV=
SECRET_KEY=
ALLOWED_ORIGINS=

# Security & JWT Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chat History Limit
CHAT_HISTORY_LIMIT=20

# Database & Caching
DATABASE_URL=
REDIS_URL=

# Celery Configurations
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI Provider Selection (openai or gemini)
AI_PROVIDER=openai

# OpenAI Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Gemini Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Integration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Rate Limits
RATE_LIMIT_CHAT=30
RATE_LIMIT_AUTH=10

# Monitoring
SENTRY_DSN=
